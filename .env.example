# Copy to .env with `make env` - every `change-me` is replaced by a random secret.
# .env is git-ignored; never commit real values.

# ---------------------------------------------------------------- simulated clock
# Real seconds per simulated day (300 = 1 sim day every 5 real minutes).
SIM_DAY_SECONDS=300
# Simulated calendar date the clock starts from on a fresh stack.
SIM_START_DATE=2026-01-01
# How often long-running components re-read the shared clock anchor (real seconds).
SIM_CLOCK_REFRESH_SECONDS=30
LOG_LEVEL=INFO

# ------------------------------------------------------------- vitals simulator
SIM_PATIENTS=20
# Total readings per real second across the ward (20 patients / 20 per s = 1 reading
# per patient per real second = every ~4.8 simulated minutes).
SIM_RATE=20
# Same seed = same patients, baselines and deterioration storylines.
SIM_SEED=42
SIM_DETERIORATING_FRACTION=0.5
SIM_SPIKE_RATE=0.01
# Fault injection (fractions of readings).
SIM_MALFORMED_RATE=0.02
SIM_LATE_RATE=0.02
SIM_DUPLICATE_RATE=0.01
# Late events arrive this many simulated minutes behind the clock.
SIM_LATE_MIN_MINUTES=5
SIM_LATE_MAX_MINUTES=120

# ---------------------------------------------------------------- lab simulator
# Day D's file (results collected on D) is uploaded at this simulated hour on D+1.
LAB_UPLOAD_HOUR=6
# Fraction of days whose file arrives 2..LAB_LATE_MAX_HOURS sim-hours late.
LAB_LATE_RATE=0.10
LAB_LATE_MAX_HOURS=8
# Fraction of days whose file never arrives (drives the missing-file alert).
LAB_MISSING_RATE=0.05
# Fraction of rows corrupted (bad values, unknown patients, duplicates, ...).
LAB_BAD_ROW_RATE=0.03
# After downtime, deliver at most this many overdue past days.
LAB_MAX_BACKFILL_DAYS=2

# ------------------------------------------------------------ lab ingestion DAG
# A file not in landing/ by LAB_UPLOAD_HOUR + LAB_SLA_HOURS (sim time) is "missing".
LAB_SLA_HOURS=4
# Quarantine the whole file if more than this fraction of rows fail validation.
LAB_MAX_REJECT_RATE=0.2
# Sensor poke interval, REAL seconds.
LAB_POKE_SECONDS=10
# Daily report: how long (REAL seconds) to wait for Spark to load the day's labs.
REPORT_LABS_WAIT_SECONDS=120

# ------------------------------------------------------------- stream processing
# Event-time settings are SIMULATED time (30 sim-minutes = 6.25 real s at x288).
# Changing window/watermark semantics requires a fresh checkpoint (make stream-reset).
STREAM_WATERMARK=30 minutes
# Processing-time triggers are REAL time.
STREAM_TRIGGER=5 seconds
STREAM_SLOW_TRIGGER=15 seconds
STREAM_MAX_OFFSETS_PER_TRIGGER=20000
# Minimum readings in a 4 h window before its slope is trusted.
TREND_MIN_READINGS=20

# -------------------------------------------------------------------------- API
# Unacknowledged alerts from the last N simulated hours count as "active".
ALERT_ACTIVE_HOURS=2

# ------------------------------------------------------------------------ Kafka
# KRaft cluster id (not a secret; any base64 UUID works).
KAFKA_CLUSTER_ID=wZ3nq4XfTmSb1vK8cL2o9A
TOPIC_VITALS=vitals.raw
TOPIC_LABS=labs.raw
TOPIC_ALERTS=alerts.patient
TOPIC_DEADLETTER=deadletter
VITALS_PARTITIONS=6
LABS_PARTITIONS=3
ALERTS_PARTITIONS=3

# --------------------------------------------------------------------- Postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
WARD_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me

# ---------------------------------------------------------------------- Airflow
# UI login: admin / AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me

# ---------------------------------------------------------------------- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ------------------------------------------------- host ports (127.0.0.1 only)
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9094
AIRFLOW_HOST_PORT=8080
API_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
SPARK_UI_HOST_PORT=4040
VITALS_METRICS_HOST_PORT=8001
LAB_METRICS_HOST_PORT=8002
SPARK_METRICS_HOST_PORT=8003
